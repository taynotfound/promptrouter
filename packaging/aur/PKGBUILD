# Maintainer: taynotfound <marztayron@gmail.com>
# PKGBUILD for building promptrouter on Arch Linux: `makepkg -si` from this dir.
# Build-from-source variant so it works on any arch Arch supports.
# sha256sums is SKIP because GitHub's auto-generated tag archives are not
# guaranteed to be byte-stable; makepkg still verifies the tag it downloads.
pkgname=promptrouter
pkgver=0.3.0
pkgrel=1
pkgdesc="Judge a coding task and route it to the right model: local GPU for easy work, cloud only when needed"
arch=('x86_64' 'aarch64')
url="https://github.com/taynotfound/promptrouter"
license=('MIT')
makedepends=('go')
optdepends=('ollama: local model backend')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cd "$pkgname-$pkgver"
  export CGO_ENABLED=0
  export GOFLAGS="-trimpath -mod=readonly -modcacherw"
  go build -ldflags "-s -w -X main.version=$pkgver" -o route ./cmd/route
}

check() {
  cd "$pkgname-$pkgver"
  go test ./...
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 route "$pkgdir/usr/bin/route"
  install -Dm644 models.yaml "$pkgdir/etc/promptrouter/models.yaml"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
